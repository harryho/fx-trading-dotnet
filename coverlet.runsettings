<?xml version="1.0" encoding="utf-8"?>
<!--
  Code coverage settings for the FXPA baseline suite.

  Pass this file to dotnet test with the settings switch, for example:

      dotnet test fx-trading-dotnet.sln -c Release -s coverlet.runsettings

  (On WSL call the SDK directly, e.g.
   /mnt/c/Users/harry/scoop/apps/dotnet10-sdk/current/dotnet.exe test ... )

  What this file does:

  * Excludes GENERATED code - the WinForms designer output, the resource
    and settings designers, and the assembly attributes. None of it is
    hand-written logic; it is regenerated by the tooling and can never be
    meaningfully covered by a test.

  * Excludes VENDORED third-party components - code that came from
    elsewhere and is not ours to cover. Each entry below states why.

  * Everything else - the application's own logic - stays in the report.

  The .NET framework itself and the NuGet packages are already excluded
  by coverlet's defaults (they are never instrumented), so they need no
  entry here. The TA-Lib binary is a pre-built DLL with no source; it is
  not instrumented either.

  After changing the exclusions, re-measure and update the number in
  README.md - the recorded coverage figure must describe the same set of
  files the report contains.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Generated code: WinForms designer output, resource/settings designers, assembly attributes.
               Vendored third-party components (not ours to cover): QuickenToolStrip / TitleStrip /
               HeaderRenderer declare namespaces of the .NET framework and of the "Samples" tree -
               they are components and sample code that arrived from outside. DOATransparentLabel,
               ManagedTreeView, DSWebClient and ThreadPoolEx are vendor components that kept their
               product names; the application only calls them.
               All patterns in one element: a second ExcludeByFile would shadow the first. -->
          <ExcludeByFile>**/*.designer.cs,**/*.Designer.cs,**/Properties/AssemblyInfo.cs,**/Properties/Resources.Designer.cs,**/Properties/Settings.Designer.cs,**/UI/QuickenToolStrip.cs,**/UI/TitleStrip.cs,**/UI/HeaderRenderer.cs,**/UI/DOATransparentLabel.cs,**/UI/ManagedTreeView.cs,**/Net/DSWebClient.cs,**/Common/ThreadEx/ThreadPoolEx.cs</ExcludeByFile>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <SingleHit>false</SingleHit>
          <!-- SourceLink off: it rewrites the reported file names into
               raw.githubusercontent.com URLs, which breaks the path based
               exclusions above. Local paths keep the report portable
               and the exclusions working. -->
          <UseSourceLink>false</UseSourceLink>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
