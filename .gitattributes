# Normalise line endings: check in LF, check out CRLF on Windows.
* text=auto eol=crlf

# Binary assets - never touched
*.dll   binary
*.exe   binary
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.bmp   binary
*.wav   binary
*.cdl   binary
*.swf   binary

# Keep the solution and project files as-is (MSBuild tolerates either)
*.sln   text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
