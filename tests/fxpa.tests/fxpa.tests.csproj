<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <RootNamespace>fxpa.tests</RootNamespace>
    <AssemblyName>fxpa.tests</AssemblyName>
    <!-- The test code is new: hold it to a modern bar, unlike the legacy tree. -->
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <!-- Opt-in coverage: only active when dotnet test is passed the collect switch
         with "XPlat Code Coverage", so the everyday suite stays fast. TestResults/ is git-ignored. -->
    <PackageReference Include="coverlet.collector" Version="6.0.4" PrivateAssets="all" />
  </ItemGroup>

  <!-- Golden-master fixtures, generated by tests/golden/generate_goldens.py. -->
  <ItemGroup>
    <Content Include="..\golden\Golden\inputs.json" CopyToOutputDirectory="PreserveNewest" LinkBase="golden\" />
    <Content Include="..\golden\Golden\**\*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="golden\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\fxpa\fxpa.csproj" />
    <Reference Include="..\..\src\lib\TA-Lib-Core.dll" />
  </ItemGroup>

</Project>
