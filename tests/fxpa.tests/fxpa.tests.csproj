<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <RootNamespace>fxpa.tests</RootNamespace>
    <AssemblyName>fxpa.tests</AssemblyName>
    <!-- The test code is new: hold it to a modern bar, unlike the legacy tree. -->
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <!-- Coverage is collected on demand only (CollectCoverage=false by default),
         so the everyday suite stays fast. The measurement scope lives here,
         next to the code it applies to, so it cannot be forgotten: no separate
         settings file to pass and no chance of measuring the wrong thing. -->
    <PackageReference Include="coverlet.msbuild" Version="6.0.4" PrivateAssets="all" />
  </ItemGroup>

  <!-- Coverage scope: the application's own code only.
       - the WinForms designer output, the settings/resource designers and the
         assembly attributes are generated; they cannot be meaningfully tested;
       - the vendored third-party components are not ours to cover:
         QuickenToolStrip, TitleStrip and HeaderRenderer declare namespaces of
         the .NET framework and of its Samples tree, while DOATransparentLabel,
         ManagedTreeView, DSWebClient and ThreadPoolEx are vendor components
         that kept their product names. The application only calls them.
       The .NET framework and the NuGet packages are never instrumented by
       coverlet in the first place. -->
  <PropertyGroup>
    <CollectCoverage>false</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <!-- One deterministic file, so a stale report can never be merged in. -->
    <CoverletOutput>$(MSBuildProjectDirectory)/TestResults/coverage/</CoverletOutput>
    <!-- The pattern lists are comma separated - coverlet splits them on commas,
         so a semicolon list would be read as one single (never matching) pattern. -->
    <ExcludeByFile>**/*.designer.cs,**/*.Designer.cs,**/Properties/AssemblyInfo.cs,**/Properties/Resources.Designer.cs,**/Properties/Settings.Designer.cs,**/*QuickenToolStrip.cs,**/*TitleStrip.cs,**/*HeaderRenderer.cs,**/*DOATransparentLabel.cs,**/*ManagedTreeView.cs,**/*DSWebClient.cs,**/*ThreadPoolEx.cs</ExcludeByFile>
    <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
    <IncludeTestAssembly>false</IncludeTestAssembly>
    <SkipAutoProps>true</SkipAutoProps>
    <UseSourceLink>false</UseSourceLink>
  </PropertyGroup>

  <!-- Golden-master fixtures, generated by tests/golden/generate_goldens.py. -->
  <ItemGroup>
    <Content Include="..\golden\Golden\inputs.json" CopyToOutputDirectory="PreserveNewest" LinkBase="golden\" />
    <Content Include="..\golden\Golden\**\*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="golden\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\fxpa\fxpa.csproj" />
    <Reference Include="..\..\src\lib\TA-Lib-Core.dll" />
  </ItemGroup>

</Project>
